# ========================================================
# MediFlow Central Environment Configuration (.env.example)
# Copy to .env and configure values. NEVER commit real secrets.
# ========================================================

# Application Environment
APP_NAME=MediFlow
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Authentication & Security Secrets
SECRET_KEY=dev_secret_key_change_in_production_32chars_min_mediflow
AUTH_SECRET=dev_auth_secret_token_change_in_production
AUTH_ISSUER=mediflow-auth
ACCESS_TOKEN_EXPIRE_MINUTES=480

# QR Verification HMAC Secret
QR_HMAC_SECRET=dev_qr_hmac_secret_mediflow_token

# Operational Database (YugabyteDB YSQL / PostgreSQL-compatible)
# Local development fallback: sqlite:///./mediflow.db
# YugabyteDB instance format: postgresql://yugabyte:yugabyte@localhost:5433/mediflow
DATABASE_URL=sqlite:///./mediflow.db
DB_ECHO=false

# Google Gemini API (Structured Reasoning, Risk Explanations)
# Leave as placeholder for automatic simulation fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MEKO Shared Agent Memory & Operational Knowledge
# Leave as placeholder for automatic simulation fallback
MEKO_API_KEY=your_meko_api_key_here
MEKO_BASE_URL=https://api.mekodata.ai/v1
MEKO_MCP_URL=
MEKO_DATAPACK_ID=

# Frontend Public Environment Variables (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
