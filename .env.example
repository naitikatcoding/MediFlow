# Stockout Shield Environment Variables Configuration

# Backend Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
SECRET_KEY=dev_secret_key_change_in_production_32chars_min_stockout_shield

# Database (Operational Source of Truth)
# For local development with fallback: sqlite:///./stockout_shield.db
# For PostgreSQL / YugabyteDB YSQL: postgresql://yugabyte:yugabyte@localhost:5433/stockout_shield
DATABASE_URL=sqlite:///./stockout_shield.db
DB_ECHO=false

# Google Gemini API
# Required for structured reasoning, agent explanations, and recommendation narratives
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MEKO Shared Agent Memory / Decision Traces
# Verify your MEKO instance / MCP adapter credentials
MEKO_API_KEY=your_meko_api_key_here
MEKO_BASE_URL=https://api.mekodata.ai/v1

# Security and QR
QR_HMAC_SECRET=dev_qr_hmac_secret_stockout_shield_token
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

